---
import type { SocialLink } from "../config";
import { socialBrandColors } from "../socialBrandColors";
import SocialLinkIcon from "./SocialLinkIcon.astro";

export interface Props {
  link: SocialLink;
}

const { link } = Astro.props;
const isArchived = link.status === "archived";
const hoverColor = link.brandColor ?? socialBrandColors[link.provider];
const linkClasses = isArchived
  ? "flex items-center gap-3 w-full px-4 py-3 rounded-xl bg-gray-500 dark:bg-gray-700 text-white border border-transparent shadow-sm opacity-40"
  : "group relative flex items-center gap-3 w-full px-4 py-3 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md overflow-hidden transition-all duration-300";
const iconContainerClasses = isArchived
  ? "grid place-items-center w-8 h-8 rounded-lg bg-white/15"
  : link.provider === "kofi"
    ? "relative grid place-items-center w-8 h-8 rounded-lg text-white bg-[#f4efe7]"
    : "relative grid place-items-center w-8 h-8 rounded-lg text-white [background:var(--button-color)] group-hover:bg-white/20";
const nameClasses = isArchived
  ? "font-semibold text-sm"
  : link.provider === "kofi"
    ? "relative font-semibold text-sm text-gray-800 dark:text-gray-100 group-hover:text-gray-900"
    : "relative font-semibold text-sm text-gray-800 dark:text-gray-100 group-hover:text-white";
const externalLinkIconClasses = isArchived
  ? "w-4 h-4 ml-auto text-white/80"
  : link.provider === "kofi"
    ? "relative z-10 w-4 h-4 ml-auto text-gray-400 group-hover:text-gray-900 transition-colors"
    : "relative z-10 w-4 h-4 ml-auto text-gray-400 group-hover:text-white transition-colors";
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class={linkClasses}
  style={isArchived ? undefined : `--button-color: ${hoverColor};`}
>
  {
    !isArchived && (
      <span class="absolute inset-0 [background:var(--button-color)] -translate-x-full group-hover:translate-x-0 transition-transform duration-300" />
    )
  }
  <span class={iconContainerClasses}>
    <SocialLinkIcon provider={link.provider} />
  </span>
  <span class={nameClasses}>{link.name}</span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={externalLinkIconClasses}
  >
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    <polyline points="15 3 21 3 21 9" />
    <line x1="10" x2="21" y1="14" y2="3" />
  </svg>
</a>
